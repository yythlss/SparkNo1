# ============================================================
# SparkNo1 (星火一号 / RT-Thread Studio 工程) .gitignore
# 只提交用户源码 (applications/ 等)，忽略编译产物、IDE 生成文件
# 与 RT-Thread Studio 自动链接/下载的目录
# ============================================================

# ---- 编译产物 ----
# Debug/ 由 RT-Thread Studio 生成, build/ 由 scons 生成
Debug/
build/
*.o
*.d
*.map
*.elf
*.bin
*.hex
*.axf
*.obj
*.out
*.bak
*.dep
*.i
*.lib
*.idb
*.ilk
*.pdb
*.exe
*.old

# ---- scons / menuconfig 生成的文件 ----
# 注：rtconfig.h / .config 虽由 menuconfig 生成，但本工程**必须纳入版本控制**：
#     外设开关（如 BSP_USING_UART3）就写在里面。不提交的话 clone 出来的工程
#     从站链路直接不可用（开机 [mbs] find uart3 failed）。
#     二者必须成对提交：只提交 rtconfig.h 的话，下次 menuconfig 保存会按旧的
#     .config 重新生成，把修复覆盖掉。
# .config
# rtconfig.h
.config.old
.config.*
.sconsign.dblite
rtconfig.pyc
rtconfig_preinc.h
cconfig.h

# ---- RT-Thread Studio 自动链接 / 下载的目录 (非用户源码) ----
rt-thread/
libraries/
packages/

# ---- IDE / 工具链元数据 ----
.settings/
.vscode/
DebugConfig/
RTE/
documentation/html
*~

# ---- 标签类工具 ----
GPATH
GRTAGS
GTAGS

# ---- 系统 ----
.DS_Store

# ---- 调试器日志 ----
JLinkLog.txt
JLinkSettings.ini
